<!-- Written for Vastitecture's tests: the uncompressed draw.io format. -->
<mxfile host="app.diagrams.net">
  <diagram id="p1" name="Checkout sketch">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="grp" value="Shop" style="swimlane;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Web &lt;b&gt;front&lt;/b&gt;end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="grp">
          <mxGeometry x="20" y="40" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Orders DB" style="shape=cylinder3;whiteSpace=wrap;html=1;" vertex="1" parent="grp">
          <mxGeometry x="240" y="40" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ok" value="Paid?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="100" height="80" as="geometry" />
        </mxCell>
        <UserObject label="Customer" tooltip="Buys things" id="cust">
          <mxCell style="shape=umlActor;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1">
            <mxGeometry x="680" y="60" width="30" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="note" value="Draft only" style="text;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="writes" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="web" target="db">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="110" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="" style="dashed=1;" edge="1" parent="1" source="cust" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" value="browses" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=none;" edge="1" parent="1" source="db" target="ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loose" style="" edge="1" parent="1" source="ok">
          <mxGeometry relative="1" as="geometry"><mxPoint x="900" y="100" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
