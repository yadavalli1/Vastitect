{
  "$id": "https://github.com/yadavalli1/Vastitect/blob/main/packages/schema/element.schema.json",
  "title": "element",
  "description": "model/elements/<pack>/<type>/<slug>.yaml: one element",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "plan",
            "phaseIn",
            "active",
            "phaseOut",
            "endOfLife"
          ]
        },
        "dates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "default": {}
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "repo",
              "runbook",
              "adr",
              "doc",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "href"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "facets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "type",
    "name"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
